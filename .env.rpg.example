# ==== RPG Database (fully isolated from the football-cards DB) ====
#
# Backs docker-compose.rpg.yml ONLY. This is a separate Postgres instance,
# volume, network, and credential set from the existing football-cards app's
# .env / DB_* variables — never merge the two.
#
# Copy this file to .env.rpg.local for local dev (already covered by
# .gitignore's ".env.*.local" pattern, same convention as the existing
# .env -> not committed) and adjust the password before using it anywhere
# beyond a throwaway local container.

RPG_DB_NAME=rpg_game
RPG_DB_USER=rpg_admin
RPG_DB_PASSWORD=change_me_rpg_password
# Host-mapped port for docker-compose.rpg.yml's postgres service. Deliberately
# NOT 5434 (that's the football-cards DB's host port) to avoid any collision
# when both stacks run at once. Pick whatever's free on your machine — 5437
# is just what happened to be open when this was set up.
RPG_DB_EXTERNAL_PORT=5437

# The backend and bot both read this (see rpg-backend/app/config.py,
# rpg-bot/config.py — the bot strips the "+asyncpg" suffix itself, since
# asyncpg's raw DSN doesn't understand SQLAlchemy's dialect suffix). From
# inside the rpg-game compose network that's the "postgres" service name;
# from the host (e.g. to run Alembic locally, or verify the connection)
# it's localhost on RPG_DB_EXTERNAL_PORT.
RPG_DATABASE_URL=postgresql+asyncpg://${RPG_DB_USER}:${RPG_DB_PASSWORD}@postgres:5432/${RPG_DB_NAME}
RPG_DATABASE_URL_HOST=postgresql+asyncpg://${RPG_DB_USER}:${RPG_DB_PASSWORD}@localhost:${RPG_DB_EXTERNAL_PORT}/${RPG_DB_NAME}

# Host-mapped port for the RPG backend API (docker-compose.rpg.yml's
# "backend" service). Football's backend uses 8000 — pick anything free.
RPG_BACKEND_PORT=8100

# ==== Admin (Stage 5+) ====
# Comma-separated Telegram ids that get admin rights (checked on every admin
# request, not just trusted from the DB row — see get_current_admin). The
# dev-mode user's id (999000001, RPG_DEV_USER_TELEGRAM_ID's default) is
# included by default so local dev/testing can reach /admin/* without a real
# Telegram account.
RPG_ADMIN_TELEGRAM_IDS=999000001
# Signs admin JWTs minted at /auth/session — change this for anything beyond
# a throwaway local container.
RPG_JWT_SECRET=change_me_rpg_jwt_secret

# ==== Telegram bot (Vardren) ====
# Register a real bot via @BotFather to get a token — required for anything
# beyond RPG_DEV_MODE local testing (the backend's initData HMAC check and
# the bot's own polling both need a genuine token, and they must be the
# SAME bot). "0:DEV" is a harmless placeholder that never authenticates
# against real Telegram.
RPG_TELEGRAM_BOT_TOKEN=0:DEV
# Used to build the /invite deep link (t.me/<username>?start=ref_<id>) —
# set this to whatever you registered with @BotFather.
RPG_TELEGRAM_BOT_USERNAME=vardren_bot
# Public URL where the Mini App frontend is served — set in @BotFather's
# /setmenubutton, and what the bot's "Открыть Vardren" button opens.
# localhost is fine for RPG_DEV_MODE testing outside real Telegram; a real
# Telegram client needs an https URL (e.g. via a tunnel, same as the
# football app's docker-compose.override.yml pattern).
RPG_MINI_APP_URL=http://localhost:5174
# "polling" (dev, no public URL needed) or "webhook" (prod).
RPG_BOT_MODE=polling
RPG_BOT_WEBHOOK_URL=https://example.com/bot/webhook
RPG_BOT_WEBHOOK_SECRET=change_me_rpg_webhook_secret
# Optional forward proxy for reaching api.telegram.org, e.g.
# "socks5://user:pass@host:1080" or "http://host:8080". Leave empty to
# connect directly.
RPG_TELEGRAM_PROXY_URL=
